###############################################################################
# 📏 SATIR SONU NORMALİZASYONU (LINE ENDINGS)
###############################################################################
* text=auto

###############################################################################
# 🎯 GITHUB DİL İSTATİSTİKLERİ (LINGUIST) - SADECE C# GÖRÜNSÜN
###############################################################################
# Önce her şeyi dökümantasyon/görünmez olarak işaretliyoruz [cite: 2026-02-10]
* linguist-detectable=false

# Sadece C# dosyalarını istatistiklere (Pure C# barı için) dahil et [cite: 2026-02-10]
*.cs linguist-detectable=true
*.csproj linguist-detectable=true
*.sln linguist-detectable=true

# PureBasic ve diğer sızıntıları dökümantasyon say, kod sayma [cite: 2026-02-10]
*.pb linguist-documentation=true
*.pbi linguist-documentation=true
*.json linguist-documentation=true
*.yml linguist-documentation=true
*.md linguist-documentation=true
*.html linguist-documentation=true

###############################################################################
# 🔨 PROJE & SOLUTION DOSYALARI (MERGE AYARLARI)
###############################################################################
*.sln     merge=binary
*.csproj  merge=binary

###############################################################################
# 🖼️ BİNARY DOSYALAR (GÖRSEL VE DİĞERLERİ)
###############################################################################
*.jpg   binary
*.png   binary
*.gif   binary
*.ico   binary
*.pdf   diff=astextplain

###############################################################################
# 💻 C# DIFF DAVRANIŞI
###############################################################################
*.cs     diff=csharp